# syntax=docker/dockerfile:1.7

ARG UBUNTU_VERSION=26.04

FROM ubuntu:${UBUNTU_VERSION} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git
ARG LLAMA_REF=72cda4a2228c254f95a556fa238488a1324b04d8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    glslc \
    libvulkan-dev \
    ninja-build \
    pkg-config \
    spirv-headers \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN git clone "${LLAMA_REPO}" llama.cpp \
 && cd llama.cpp \
 && git checkout "${LLAMA_REF}" \
 && test "$(git rev-parse HEAD)" = "${LLAMA_REF}" \
 && git --no-pager log -1 --oneline

WORKDIR /build/llama.cpp

# Deliberately do not use GGML_NATIVE here. GitHub-hosted runners are not
# Strix Halo machines; native CPU tuning would optimize for the runner CPU.
RUN cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DGGML_VULKAN=ON \
      -DGGML_NATIVE=OFF \
      -DLLAMA_CURL=OFF \
 && cmake --build build \
      --target llama-server \
      --parallel "$(nproc)"

FROM ubuntu:${UBUNTU_VERSION} AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    libgomp1 \
    libvulkan1 \
    vulkan-tools \
 && curl --fail --location --retry 3 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xEB8B81E14DA65431D7504EA8F63F0F2B90935439' -o /tmp/kisak.asc \
 && test "$(gpg --show-keys --with-colons /tmp/kisak.asc | awk -F: '$1 == "fpr" {print $10; exit}')" = EB8B81E14DA65431D7504EA8F63F0F2B90935439 \
 && gpg --dearmor -o /usr/share/keyrings/kisak-mesa.gpg /tmp/kisak.asc \
 && echo 'deb [signed-by=/usr/share/keyrings/kisak-mesa.gpg] https://ppa.launchpadcontent.net/kisak/kisak-mesa/ubuntu resolute main' > /etc/apt/sources.list.d/kisak-mesa.list \
 && apt-get update -o Acquire::Retries=3 \
 && apt-get install -y --no-install-recommends 'mesa-vulkan-drivers=26.3.1~kisak2~r' \
 && dpkg-query -W mesa-vulkan-drivers libvulkan1 \
 && rm -rf /var/lib/apt/lists/* /tmp/kisak.asc

COPY --from=builder /build/llama.cpp/build/bin/llama-server /usr/local/bin/
COPY --from=builder /build/llama.cpp/build/bin/*.so* /usr/local/lib/

RUN ldconfig

ENV AMD_VULKAN_ICD=RADV
ENV VK_LOADER_DEBUG=error

WORKDIR /models

ENTRYPOINT ["/usr/local/bin/llama-server"]
