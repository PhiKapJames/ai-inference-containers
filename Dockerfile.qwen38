# syntax=docker/dockerfile:1.7

ARG UBUNTU_VERSION=26.04

FROM ubuntu:${UBUNTU_VERSION} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git
ARG LLAMA_REF=23b0202a189c44a54625aadcb37a946dd1d6278d

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    glslc \
    libvulkan-dev \
    ninja-build \
    pkg-config \
    spirv-headers \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN git clone "${LLAMA_REPO}" llama.cpp \
 && cd llama.cpp \
 && git checkout "${LLAMA_REF}" \
 && test "$(git rev-parse HEAD)" = "${LLAMA_REF}" \
 && git --no-pager log -1 --oneline

WORKDIR /build/llama.cpp

# Qwen3.8 Flash-Next native vision sends embeddings through the target graph.
# At this pinned upstream revision, the Qwen4Exp MTP graph still contains an
# obsolete token-only assertion even though the embeddings path is implemented.
# Remove exactly that assertion and fail the build if the expected source line
# is no longer present, so this patch cannot silently drift.
RUN test "$(grep -Fc 'GGML_ASSERT(ubatch.token && "qwen4exp MTP requires token input");' src/models/qwen4exp.cpp)" = "1" \
 && sed -i '/GGML_ASSERT(ubatch.token && "qwen4exp MTP requires token input");/d' src/models/qwen4exp.cpp \
 && ! grep -Fq 'GGML_ASSERT(ubatch.token && "qwen4exp MTP requires token input");' src/models/qwen4exp.cpp

# Deliberately do not use GGML_NATIVE here. GitHub-hosted runners are not
# Strix Halo machines; native CPU tuning would optimize for the runner CPU.
RUN cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DGGML_VULKAN=ON \
      -DGGML_NATIVE=OFF \
      -DLLAMA_CURL=OFF \
 && cmake --build build \
      --target llama-server \
      --parallel "$(nproc)"

FROM ubuntu:${UBUNTU_VERSION} AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgomp1 \
    libvulkan1 \
    mesa-vulkan-drivers \
    vulkan-tools \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/llama.cpp/build/bin/llama-server /usr/local/bin/
COPY --from=builder /build/llama.cpp/build/bin/*.so* /usr/local/lib/

RUN ldconfig

ENV AMD_VULKAN_ICD=RADV
ENV VK_LOADER_DEBUG=error

WORKDIR /models

ENTRYPOINT ["/usr/local/bin/llama-server"]
